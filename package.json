{
  "name": "resend-approvals",
  "version": "0.1.0",
  "description": "An approval service for agent-drafted email: agents prepare drafts through a REST API, a human reviews and approves them, and approved emails are sent through Resend.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
